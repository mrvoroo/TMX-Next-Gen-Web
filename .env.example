# Copy to .env.local and fill in. Never commit real keys.

# Public origin of the site (canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://tmx1.netlify.app

# KI-Potenzial-Check: off | demo | live   (default: demo)
# "live" only works if AI_PRIVACY_APPROVED=true AND MISTRAL_API_KEY is set –
# otherwise the tool stays in demo mode. Read docs/legal/drafts/ki-potenzial-check.md first.
AI_TOOL_MODE=demo
AI_PRIVACY_APPROVED=false
MISTRAL_API_KEY=
# Optional, default: mistral-small-latest
AI_MODEL=
